// SECURITY HARDENED VERSION
// This replaces parts of Code.gs with improved security measures

// ============================================================================
// STEP 1: Use Script Properties instead of hardcoded values
// Set these via: Apps Script Editor → Project Settings → Script Properties
// ============================================================================

function getSecureConfig_() {
  const props = PropertiesService.getScriptProperties();
  
  return {
    STAFF_PIN: props.getProperty('STAFF_PIN'),
    GOOGLE_CLIENT_ID: props.getProperty('GOOGLE_CLIENT_ID'),
    STAFF_EMAILS: (props.getProperty('STAFF_EMAILS') || '')
      .toLowerCase()
      .split(',')
      .map(e => e.trim())
      .filter(Boolean),
    API_SECRET: props.getProperty('API_SECRET'),
    ALLOWED_ORIGINS: (props.getProperty('ALLOWED_ORIGINS') || 'https://pawansos.github.io')
      .split(',')
      .map(o => o.trim())
      .filter(Boolean)
  };
}

// ============================================================================
// STEP 2: Validate request origin (CORS/Referer check)
// ============================================================================

function validateRequestOrigin_(e) {
  const config = getSecureConfig_();
  const referer = String(e.parameter.referer || e.headers['Referer'] || '');
  
  const isValidOrigin = config.ALLOWED_ORIGINS.some(origin => 
    referer.toLowerCase().startsWith(origin.toLowerCase())
  );
  
  if (!isValidOrigin && referer) {
    // Log suspicious request
    Logger.log('SECURITY: Request from unauthorized origin: ' + referer);
    throw new Error('Unauthorized request origin');
  }
  
  return true;
}

// ============================================================================
// STEP 3: Rate limiting by IP address
// ============================================================================

function checkRateLimit_(remoteAddress, action) {
  const cache = CacheService.getScriptCache();
  const key = `ratelimit:${remoteAddress}:${action}`;
  const current = parseInt(cache.get(key) || '0');
  
  // Allow 15 requests per minute per IP
  const limit = 15;
  
  if (current >= limit) {
    Logger.log('SECURITY: Rate limit exceeded for IP ' + remoteAddress + ' action: ' + action);
    throw new Error('Too many requests. Please try again in a moment.');
  }
  
  cache.put(key, String(current + 1), 60); // 60 second TTL
}

// ============================================================================
// STEP 4: Generate cryptographically secure session tokens
// ============================================================================

function generateSecureSessionToken_() {
  // Use Utilities.getUuid() which is cryptographically secure
  const token = Utilities.getUuid();
  return token;
}

// ============================================================================
// STEP 5: Create staff session with improved security
// ============================================================================

function createStaffSession_(body) {
  const config = getSecureConfig_();
  
  // Validate required config
  if (!config.GOOGLE_CLIENT_ID) {
    throw new Error('Google Client ID not configured in Script Properties');
  }
  if (!config.STAFF_PIN) {
    throw new Error('Staff PIN not configured in Script Properties');
  }
  if (config.STAFF_EMAILS.length === 0) {
    throw new Error('Staff emails not configured in Script Properties');
  }

  const idToken = String(body.googleIdToken || '');
  if (!idToken) {
    throw authRequiredError_('Sign in with Google before using check-in.');
  }

  // Verify Google ID Token
  let claims;
  try {
    const response = UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(idToken), {
      muteHttpExceptions: true,
      headers: { 'User-Agent': 'VenueCheckin/1.0' }
    });
    
    if (response.getResponseCode() !== 200) {
      Logger.log('SECURITY: Invalid Google token');
      throw new Error('Invalid token');
    }
    
    claims = JSON.parse(response.getContentText());
  } catch (err) {
    Logger.log('SECURITY: Google token verification failed: ' + err);
    throw authRequiredError_('Google sign-in could not be verified. Sign in again.');
  }

  // Validate token claims
  const email = String(claims.email || '').trim().toLowerCase();
  const validIssuer = claims.iss === 'accounts.google.com' || claims.iss === 'https://accounts.google.com';
  const tokenExpired = Number(claims.exp) * 1000 <= Date.now();
  
  if (claims.aud !== config.GOOGLE_CLIENT_ID) {
    Logger.log('SECURITY: Token audience mismatch for email: ' + email);
    throw authRequiredError_('This app is not authorized for this Google account.');
  }
  
  if (!validIssuer) {
    Logger.log('SECURITY: Invalid token issuer');
    throw authRequiredError_('Invalid token issuer');
  }
  
  if (String(claims.email_verified) !== 'true') {
    Logger.log('SECURITY: Email not verified for ' + email);
    throw authRequiredError_('Your Google email is not verified.');
  }
  
  if (tokenExpired) {
    Logger.log('SECURITY: Expired token for ' + email);
    throw authRequiredError_('Your Google session has expired. Sign in again.');
  }

  // Check if email is approved for staff access
  if (!config.STAFF_EMAILS.includes(email)) {
    Logger.log('SECURITY: Unauthorized staff email: ' + email);
    throw new Error('This Google account is not approved for staff check-in.');
  }

  // Verify PIN
  const pin = String(body.pin || '').trim();
  if (pin !== config.STAFF_PIN) {
    Logger.log('SECURITY: Invalid PIN attempt for ' + email);
    throw new Error('Invalid PIN. Please try again.');
  }

  // Create secure session
  const sessionToken = generateSecureSessionToken_();
  const cache = CacheService.getScriptCache();
  
  // Store session with 15-minute TTL (900 seconds)
  const sessionData = {
    email: email,
    createdAt: Date.now(),
    expiresAt: Date.now() + (15 * 60 * 1000)
  };
  
  cache.put('session:' + sessionToken, JSON.stringify(sessionData), 900);
  
  Logger.log('Staff session created for: ' + email);
  
  return {
    status: 'VALID',
    message: 'Staff session created',
    sessionToken: sessionToken,
    email: email
  };
}

// ============================================================================
// STEP 6: Validate session with security checks
// ============================================================================

function getStaffSession_(sessionToken) {
  if (!sessionToken || typeof sessionToken !== 'string') {
    return null;
  }

  const cache = CacheService.getScriptCache();
  const data = cache.get('session:' + sessionToken);
  
  if (!data) {
    Logger.log('SECURITY: Invalid or expired session token');
    return null;
  }

  try {
    const session = JSON.parse(data);
    
    // Verify session hasn't expired
    if (session.expiresAt && Date.now() > session.expiresAt) {
      Logger.log('SECURITY: Session expired for ' + session.email);
      cache.remove('session:' + sessionToken);
      return null;
    }
    
    return session;
  } catch (err) {
    Logger.log('SECURITY: Failed to parse session data: ' + err);
    return null;
  }
}

// ============================================================================
// STEP 7: Improved doPost with all security checks
// ============================================================================

function doPost(e) {
  const remoteIp = e.remoteAddress || 'unknown';
  
  try {
    // Validate request origin
    validateRequestOrigin_(e);
    
    // Parse request body
    let body;
    try {
      body = JSON.parse(e.postData.contents);
    } catch (err) {
      Logger.log('SECURITY: Malformed request from ' + remoteIp);
      return jsonResponse_({ status: "ERROR", message: "Malformed request." });
    }

    if (!body || typeof body !== 'object') {
      Logger.log('SECURITY: Invalid request body from ' + remoteIp);
      return jsonResponse_({ status: "ERROR", message: "Invalid request." });
    }

    // Normalize request body
    body = normalizeRequestBody_(body);

    // Rate limit per IP and action
    checkRateLimit_(remoteIp, body.action || 'unknown');

    // Login action (no session token required)
    if (body.action === 'login') {
      const result = createStaffSession_(body);
      Logger.log('Login successful for: ' + result.email);
      return jsonResponse_(result);
    }

    // All other actions require valid session
    const staff = getStaffSession_(body.sessionToken);
    if (!staff) {
      Logger.log('SECURITY: Unauthorized action attempt from ' + remoteIp + ' action: ' + body.action);
      return jsonResponse_({ status: 'AUTH_REQUIRED', message: 'Staff session expired. Sign in again.' });
    }

    // Log the action
    Logger.log('Action: ' + body.action + ' by ' + staff.email);

    // Handle logout
    if (body.action === 'logout') {
      CacheService.getScriptCache().remove('session:' + body.sessionToken);
      Logger.log('Logout for: ' + staff.email);
      return jsonResponse_({ status: 'OK' });
    }

    // Handle other actions
    const query = String(body.query || "").trim();
    if (body.action === "lookup") {
      return jsonResponse_(lookupRegistration(query));
    } else if (body.action === "confirm") {
      return jsonResponse_(confirmEntry(query, staff.email));
    } else if (body.action === "stats") {
      return jsonResponse_(getLiveStats_());
    }
    
    Logger.log('SECURITY: Unknown action: ' + body.action);
    return jsonResponse_({ status: "ERROR", message: "Unknown action." });

  } catch (err) {
    Logger.log('ERROR: ' + err.toString() + ' from IP: ' + remoteIp);
    return jsonResponse_({
      status: err.code === 'AUTH_REQUIRED' ? 'AUTH_REQUIRED' : 'ERROR',
      message: err.message || 'An error occurred'
    });
  }
}

// ============================================================================
// Helper to create proper error with code
// ============================================================================

function authRequiredError_(message) {
  const error = new Error(message);
  error.code = 'AUTH_REQUIRED';
  return error;
}

// ============================================================================
// Helper to return JSON response
// ============================================================================

function jsonResponse_(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

