// MINIMAL SECURITY FIX
// Just move secrets to Script Properties - that's it!
// No complex changes needed.

// Replace the CONFIG.STAFF_PIN line with this function call
function getStaffPin_() {
  return PropertiesService.getScriptProperties().getProperty('STAFF_PIN');
}

function getGoogleClientId_() {
  return PropertiesService.getScriptProperties().getProperty('GOOGLE_CLIENT_ID');
}

function getStaffEmails_() {
  const emailsStr = PropertiesService.getScriptProperties().getProperty('STAFF_EMAILS') || '';
  return emailsStr.toLowerCase().split(',').map(e => e.trim()).filter(Boolean);
}

